<% layout("/layouts/boilerplate.ejs") %>
    <h3 id="mainhead">All Listings</h3>

    <!-- <form method="GET" action="/listings/new">
        <button> Create New Listing</button>
    </form> -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4">
    <%for(let list of allListing){%>
    <a href="listings/<%=list._id%>" class="listing-link">
    <div class="card col">
        <img src="<%=list.image%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
        <p class="card-text">
            <b> <%=list.title%> </b><br>
             &#8377; <%=list.price.toLocaleString("en-IN")%> / night
        </p>
    </div>
    </div>
    </a>
    <%}%>
    </div>
