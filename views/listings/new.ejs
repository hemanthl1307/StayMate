<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayMate</title>
</head>
<body>
    <h3>Create New Listing</h3>
    <form method="POST" action="/listings">
        <input type="text" name="listing[title]" placeholder="Enter title"/>
        <br><br>
        <textarea name="listing[description]" placeholder="Enter description"></textarea>
        <br><br>
        <input name="listing[image]" type="text" placeholder="Enter image URL/Link">
        <br><br>
        <input name="listing[location]" type="text" placeholder="Enter location">
        <br><br>
        <input name="listing[State]" type="text" placeholder="Enter state">
        <br><br>
        <input name="listing[category]" type="text" placeholder="Enter category">
        <br><br>
        <input name="listing[price]" type="number" placeholder="Enter price">
        <br><br>
        <button>Add</button>
    </form>
</body>
</html>