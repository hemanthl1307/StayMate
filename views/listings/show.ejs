<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
    <div class="col-8 offset-0.5 mt-3 show-title">
        <h2 id="showlist"><%=listing.title%></h2>
        <br>
    </div>
    <br>
    <div class="card col-6 offset-3 show-card">
        <img src="<%=listing.image %>" class="card-img-top" alt="listing-image">
        <div class="card-body">
        <p class="card-text"><br>
            <%=listing.description%><br>
            &#8377; <%=listing.price.toLocaleString("en-IN")%><br>
            <%=listing.location%><br>
            <%=listing.State%><br>
            <%=listing.category%><br>
        </p>
        </div>
    </div>
    <div class="btns show-btns">
    <a href="/listings/<%=listing._id%>/edit" class="btn allbtn  offset-5">Edit</a><br><br>
    
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn allbtn offset-4">Delete</button>
    </form>
    </div>
    <hr>

  <div class="review-box col-11 col-md-8 mt-3">
    <h4>Leave a Review</h4>
    <form action="/listings/<%=listing.id%>/reviews" method="POST" data-bs-validate novalidate>
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label><br>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="rangelabel form-range" required>
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some comment for review</div>
        </div>
        <button class="btn">Submit</button>
    </form>
</div>

    </div>
