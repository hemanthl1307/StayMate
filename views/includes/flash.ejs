<% if(success && success.length) { %>
<div class="alert alert-success col-6 offset-3 d-flex align-items-center" role="alert">
  <%= success %>
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if(errormsg && errormsg.length) { %>
<div class="alert alert-danger col-6 offset-3 d-flex align-items-center" role="alert">
  <%= errormsg %>
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>